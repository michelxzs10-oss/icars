---
import Layout from "../layouts/Layout.astro";
import { modelos } from "../data/modelos";
import SearchBar from "../components/SearchBar.astro";

const modelosPorMarca = modelos.reduce((acc, modelo) => {
  if (!acc[modelo.marca]) acc[modelo.marca] = [];
  acc[modelo.marca].push(modelo);
  return acc;
}, {} as Record<string, typeof modelos>);

const marcas = Object.keys(modelosPorMarca).sort();

// Genera un slug simple para cada marca, usado como id de sección
const slugify = (str: string) =>
  str.toLowerCase().replace(/\s+/g, "-").normalize("NFD").replace(/[\u0300-\u036f]/g, "");
---

<Layout
  title="iCars — Marcas"
  description="Explora el archivo de iCars agrupado por marca: todos los modelos documentados en un solo lugar."
>
  <SearchBar />
  <div class="px-6 py-12 max-w-6xl mx-auto">

    <!-- Breadcrumb -->
    <nav class="text-[11px] font-mono uppercase tracking-wide text-gray-500 mb-4">
      <a href="/" class="hover:text-black transition-colors">Inicio</a>
      <span class="mx-2">/</span>
      <span class="text-black">Marcas</span>
    </nav>

    <div class="flex items-baseline justify-between flex-wrap gap-4 mb-8">
      <h1 class="text-4xl font-extrabold tracking-tight">Marcas</h1>
      <span class="text-[11px] font-mono uppercase tracking-wide text-gray-500">
        {modelos.length} modelo{modelos.length !== 1 ? "s" : ""} en total
      </span>
    </div>

    <!-- Anchor links -->
    <nav class="sticky top-0 bg-white z-10 flex flex-wrap gap-x-4 gap-y-2 py-4 border-y border-black mb-16 text-[11px] font-mono uppercase tracking-wide">
      {marcas.map((marca) => (
        <a
        
          href={`#${slugify(marca)}`}
          class="text-black no-underline hover:opacity-60 transition-opacity"
        >
          {marca}
        </a>
      ))}
    </nav>

    {marcas.map((marca) => (
      <section id={slugify(marca)} class="mb-20 scroll-mt-20">
        <div class="flex items-baseline justify-between border-b border-black pb-2 mb-6">
          <h2 class="text-xl font-bold uppercase tracking-wide">{marca}</h2>
          <span class="text-[11px] font-mono text-gray-500 uppercase">
            {modelosPorMarca[marca].length} modelo{modelosPorMarca[marca].length !== 1 ? "s" : ""}
          </span>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {modelosPorMarca[marca].map((modelo) => (
            <a
            
              href={`/modelos/${modelo.slug}`}
              class="group relative aspect-[3/4] overflow-hidden block"
              data-cursor="Ver"
            >
              <img
                src={modelo.imagenPrincipal}
                alt={modelo.nombre}
                class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 group-hover:scale-105"
              />

              <div
                class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/0 to-transparent
                       opacity-0 group-hover:opacity-100 transition-opacity duration-500
                       flex items-end p-3"
              >
                <div class="text-white font-mono">
                  <span class="block text-xs uppercase tracking-wide">{modelo.nombre}</span>
                  <span class="block text-[10px] text-gray-300 uppercase tracking-wide">
                    {modelo.año}
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

  </div>
</Layout>