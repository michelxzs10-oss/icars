---
// src/components/Header.astro
import { modelos } from "../data/modelos";
---

<header class="w-full border-b border-black">
    <div class="flex items-start justify-between px-6 py-4">
      
      <!-- Logo -->
      <a href="/" class="text-3xl md:text-4xl font-extrabold tracking-tight font-mono">
        iCars
      </a>
  
      <!-- Bloques de la derecha -->
      <nav class="flex gap-10 text-[11px] font-mono uppercase tracking-wide leading-tight">
        
        <div class="flex flex-col">
          <a href="/" class="hover:opacity-60 transition-opacity">Home</a>
          <a href="/marcas" class="hover:opacity-60 transition-opacity">Marcas [{modelos.length}]</a>
        </div>
  
        <div class="flex flex-col">
          <a href="/About" class="hover:opacity-60 transition-opacity">About</a>
        
        </div>
  
        <div class="flex flex-col text-right">
          <span id="clock">00:00:00 GMT-6</span>
          <span>Mexico, CDMX</span>
        </div>
  
      </nav>
    </div>
  </header>
  
  <script>
    function updateClock() {
      const el = document.getElementById("clock");
      if (!el) return;
  
      const now = new Date();
      // Ajusta el timeZone según la ciudad/zona que quieras mostrar
      const timeStr = now.toLocaleTimeString("en-GB", {
        timeZone: "America/Mexico_City",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
      });
  
      el.textContent = `${timeStr} GMT-6`;
    }
  
    updateClock();
    setInterval(updateClock, 1000);
  </script>


  <style>
    nav a {
      color: inherit;
      text-decoration: none;
    }
  
    nav a:visited {
      color: inherit;
    }
  
    nav a:hover {
      opacity: 0.6;
    }
  </style>